      <column caption='Map Color Value' datatype='real' name='[Calculation_0867291341475840]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 1325787663704072]&#13;&#10;&#13;&#10;WHEN &quot;Average AQI&quot; THEN&#13;&#10;    AVG([aqi]) / 500 * 100&#13;&#10;&#13;&#10;WHEN &quot;Median AQI&quot; THEN&#13;&#10;    MEDIAN([aqi]) / 500 * 100&#13;&#10;&#13;&#10;WHEN &quot;Bad-Air %&quot; THEN&#13;&#10;    SUM([bad_air_day]) / COUNT([aqi]) * 100&#13;&#10;&#13;&#10;WHEN &quot;Observations&quot; THEN&#13;&#10;    COUNT([aqi]) / 3898 * 100&#13;&#10;&#13;&#10;END' />
      </column>
      <column caption='Observation Coverage Filter' datatype='boolean' name='[Calculation_0867291618582530]' role='measure' type='nominal'>
        <calculation class='tableau' formula='[Calculation_1325787656134659] &gt;= [Parameters].[Parameter 0867291617898497]' />
      </column>
      <column caption='Selected Metric Display' datatype='string' name='[Calculation_0867291656134659]' role='measure' type='nominal'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 1325787663704072]&#13;&#10;&#13;&#10;WHEN &quot;Average AQI&quot; THEN&#13;&#10;    STR(ROUND(AVG([aqi]), 1))&#13;&#10;&#13;&#10;WHEN &quot;Median AQI&quot; THEN&#13;&#10;    STR(ROUND(MEDIAN([aqi]), 1))&#13;&#10;&#13;&#10;WHEN &quot;Bad-Air %&quot; THEN&#13;&#10;    STR(ROUND(&#13;&#10;        SUM([bad_air_day]) / COUNT([aqi]) * 100&#13;&#10;    , 2)) + &quot;%&quot;&#13;&#10;&#13;&#10;WHEN &quot;Observations&quot; THEN&#13;&#10;    STR(COUNT([aqi]))&#13;&#10;&#13;&#10;END' />
      </column>
      <column caption='Total Pollutant Presence' datatype='integer' name='[Calculation_0867291675774989]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([has_co])&#13;&#10;+&#13;&#10;SUM([has_no2])&#13;&#10;+&#13;&#10;SUM([has_o3])&#13;&#10;+&#13;&#10;SUM([has_pm10])&#13;&#10;+&#13;&#10;SUM([has_pm25])&#13;&#10;+&#13;&#10;SUM([has_so2])' />
      </column>
      <column caption='PM10 Share' datatype='real' name='[Calculation_0867291676139534]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([has_pm10]) / [Calculation_0867291675774989]' />
      </column>
      <column caption='PM2.5 Share' datatype='real' name='[Calculation_0867291676258319]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([has_pm25]) / [Calculation_0867291675774989]' />
      </column>
      <column caption='O3 Share' datatype='real' name='[Calculation_0867291676389392]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([has_o3]) / [Calculation_0867291675774989]' />
      </column>
      <column caption='CO Share' datatype='real' name='[Calculation_0867291676512273]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([has_co]) / [Calculation_0867291675774989]' />
      </column>
      <column caption='NO2 Share' datatype='real' name='[Calculation_0867291676659730]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([has_no2]) / [Calculation_0867291675774989]' />
      </column>
      <column caption='SO2 Share' datatype='real' name='[Calculation_0867291676794899]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([has_so2]) / [Calculation_0867291675774989]' />
      </column>
      <column caption='Selected Pollutant Presence' datatype='integer' name='[Calculation_0867291685715989]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 0867291685380116]&#13;&#10;&#13;&#10;WHEN &quot;PM2.5&quot; THEN [has_pm25]&#13;&#10;WHEN &quot;PM10&quot; THEN [has_pm10]&#13;&#10;WHEN &quot;O3&quot; THEN [has_o3]&#13;&#10;WHEN &quot;CO&quot; THEN [has_co]&#13;&#10;WHEN &quot;NO2&quot; THEN [has_no2]&#13;&#10;WHEN &quot;SO2&quot; THEN [has_so2]&#13;&#10;&#13;&#10;END' />
      </column>
      <column caption='Selected Pollutant %' datatype='real' name='[Calculation_0867291687362582]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='AVG([Calculation_0867291685715989])' />
      </column>
      <column caption='Selected City Indicator' datatype='string' name='[Calculation_0867291706699799]' role='measure' type='nominal'>
        <calculation class='tableau' formula='IF COUNTD([city]) = 1 THEN&#13;&#10;    &quot;Selected: &quot; + MIN([city]) + &quot;, &quot; + MIN([state])&#13;&#10;ELSE&#13;&#10;    &quot;Selected: All Cities&quot;&#13;&#10;END' />
      </column>
      <column caption='Month Label' datatype='string' name='[Calculation_0867291710967833]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='DATENAME(&apos;month&apos;, [month_start])&#13;&#10;+ &quot; &quot;&#13;&#10;+ STR(YEAR([month_start]))' />
      </column>
      <column caption='AQI Category Explanation' datatype='string' name='[Calculation_0867291714539546]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [aqi_category]&#13;&#10;&#13;&#10;WHEN &quot;Good&quot; THEN&#13;&#10;    &quot;AQI 0-50 | Minimal impact&quot;&#13;&#10;&#13;&#10;WHEN &quot;Satisfactory&quot; THEN&#13;&#10;    &quot;AQI 51-100 | Minor breathing discomfort for sensitive people&quot;&#13;&#10;&#13;&#10;WHEN &quot;Moderate&quot; THEN&#13;&#10;    &quot;AQI 101-200 | Breathing discomfort for people with lung or heart conditions&quot;&#13;&#10;&#13;&#10;WHEN &quot;Poor&quot; THEN&#13;&#10;    &quot;AQI 201-300 | Breathing discomfort on prolonged exposure&quot;&#13;&#10;&#13;&#10;WHEN &quot;Very Poor&quot; THEN&#13;&#10;    &quot;AQI 301-400 | Respiratory illness risk on prolonged exposure&quot;&#13;&#10;&#13;&#10;WHEN &quot;Severe&quot; THEN&#13;&#10;    &quot;AQI 401-500 | Serious health effects possible&quot;&#13;&#10;&#13;&#10;END' />
      </column>
      <column caption='Selected City Details' datatype='string' name='[Calculation_0867291717349403]' role='measure' type='nominal'>
        <calculation class='tableau' formula='IF NOT ISNULL(ATTR([city])) THEN&#13;&#10;&#13;&#10;&quot;SELECTED CITY&quot; + CHAR(10) + CHAR(10) +&#13;&#10;&#13;&#10;MIN([city]) + &quot;, &quot; + MIN([state]) + CHAR(10) + CHAR(10) +&#13;&#10;&#13;&#10;&quot;Average AQI: &quot; +&#13;&#10;STR(ROUND(AVG([aqi]),1)) + CHAR(10) +&#13;&#10;&#13;&#10;&quot;Median AQI: &quot; +&#13;&#10;STR(ROUND(MEDIAN([aqi]),0)) + CHAR(10) +&#13;&#10;&#13;&#10;&quot;Bad-Air %: &quot; +&#13;&#10;STR(ROUND(SUM([bad_air_day]) / COUNT([aqi]) * 100,2)) + &quot;%&quot; + CHAR(10) +&#13;&#10;&#13;&#10;&quot;Observations: &quot; +&#13;&#10;STR(COUNT([aqi])) + CHAR(10) + CHAR(10) +&#13;&#10;&#13;&#10;&quot;Coverage: &quot; +&#13;&#10;MIN([coverage_level]) + CHAR(10) +&#13;&#10;&#13;&#10;&quot;Coverage %: &quot; +&#13;&#10;STR(ROUND(MIN([coverage_pct]),2)) + &quot;%&quot; + CHAR(10) +&#13;&#10;&#13;&#10;&quot;Years Covered: &quot; +&#13;&#10;STR(MIN([years_covered])) + CHAR(10) +&#13;&#10;&#13;&#10;&quot;Longest Gap: &quot; +&#13;&#10;STR(MIN([longest_gap])) + &quot; Days&quot;&#13;&#10;&#13;&#10;ELSE&#13;&#10;&#13;&#10;&quot;SELECTED CITY&quot; + CHAR(10) + CHAR(10) +&#13;&#10;&#13;&#10;&quot;Select a city from the map to view its details&quot;&#13;&#10;&#13;&#10;END' />
      </column>
      <column caption='Season Months' datatype='string' name='[Calculation_0867291720241180]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [season]&#13;&#10;&#13;&#10;WHEN &quot;Winter&quot; THEN&#13;&#10;&quot;December, January, February&quot;&#13;&#10;&#13;&#10;WHEN &quot;Summer&quot; THEN&#13;&#10;&quot;March, April, May&quot;&#13;&#10;&#13;&#10;WHEN &quot;Monsoon&quot; THEN&#13;&#10;&quot;June, July, August, September&quot;&#13;&#10;&#13;&#10;WHEN &quot;Post-monsoon&quot; THEN&#13;&#10;&quot;October, November&quot;&#13;&#10;&#13;&#10;END' />
      </column>
      <column caption='Country' datatype='string' name='[Calculation_0867291736432669]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='&quot;India&quot;' />
      </column>
      <column aggregation='Sum' caption='Selected Pollutant Flag' datatype='integer' name='[Calculation_0867292055552031]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 0867291685380116]&#13;&#10;&#13;&#10;WHEN &quot;PM2.5&quot; THEN [has_pm25]&#13;&#10;WHEN &quot;PM10&quot; THEN [has_pm10]&#13;&#10;WHEN &quot;O3&quot; THEN [has_o3]&#13;&#10;WHEN &quot;NO2&quot; THEN [has_no2]&#13;&#10;WHEN &quot;SO2&quot; THEN [has_so2]&#13;&#10;WHEN &quot;CO&quot; THEN [has_co]&#13;&#10;&#13;&#10;END' />
      </column>
      <column caption='Average AQI' datatype='real' name='[Calculation_1325787655204864]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='AVG([aqi])' />
      </column>
      <column caption='Median AQI' datatype='real' name='[Calculation_1325787655507969]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='MEDIAN([aqi])' />
      </column>
      <column caption='Bad-Air %' datatype='real' default-format='p0.00%' name='[Calculation_1325787655729154]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([bad_air_day]) / COUNT([aqi])' />
      </column>
      <column caption='Observation Count' datatype='integer' name='[Calculation_1325787656134659]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNT([aqi])' />
      </column>
      <column caption='City Count' datatype='integer' name='[Calculation_1325787656249348]' role='measure' type='quantitative'>
