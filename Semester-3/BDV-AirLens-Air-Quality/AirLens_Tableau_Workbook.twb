      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='airlens_historical_daily' name='federated.1j8udpt1l5kizn1aojj9h0inkld6' />
            <datasource name='Parameters' />
          </datasources>
          <mapsources>
            <mapsource name='Tableau' />
          </mapsources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Minimum Observations' datatype='integer' name='[Parameter 0867291617898497]' param-domain-type='list' role='measure' type='quantitative' value='730'>
              <calculation class='tableau' formula='730' />
              <aliases>
                <alias key='0' value='All' />
              </aliases>
            </column>
            <column caption='Metric Selector' datatype='string' name='[Parameter 1325787663704072]' param-domain-type='list' role='measure' type='nominal' value='&quot;Average AQI&quot;'>
              <calculation class='tableau' formula='&quot;Average AQI&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.1j8udpt1l5kizn1aojj9h0inkld6'>
            <column caption='Observation Coverage Filter' datatype='boolean' name='[Calculation_0867291618582530]' role='measure' type='nominal'>
              <calculation class='tableau' formula='[Calculation_1325787656134659] &gt;= [Parameters].[Parameter 0867291617898497]' />
            </column>
            <column caption='Average AQI' datatype='real' name='[Calculation_1325787655204864]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='AVG([aqi])' />
            </column>
            <column caption='Median AQI' datatype='real' name='[Calculation_1325787655507969]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='MEDIAN([aqi])' />
            </column>
            <column caption='Bad-Air %' datatype='real' default-format='p0.00%' name='[Calculation_1325787655729154]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([bad_air_day]) / COUNT([aqi])' />
            </column>
            <column caption='Observation Count' datatype='integer' name='[Calculation_1325787656134659]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNT([aqi])' />
            </column>
            <column caption='Selected Metric' datatype='real' name='[Calculation_1325787664465929]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 1325787663704072]&#13;&#10;&#13;&#10;WHEN &quot;Average AQI&quot; THEN AVG([aqi])&#13;&#10;&#13;&#10;WHEN &quot;Median AQI&quot; THEN MEDIAN([aqi])&#13;&#10;&#13;&#10;WHEN &quot;Bad-Air %&quot; THEN&#13;&#10;    SUM([bad_air_day]) / COUNT([aqi])&#13;&#10;&#13;&#10;WHEN &quot;Observations&quot; THEN&#13;&#10;    COUNT([aqi])&#13;&#10;&#13;&#10;END' />
            </column>
            <column caption='Aqi' datatype='integer' name='[aqi]' role='measure' type='quantitative' />
            <column-instance column='[coverage_level]' derivation='Attribute' name='[attr:coverage_level:nk]' pivot='key' type='nominal' />
