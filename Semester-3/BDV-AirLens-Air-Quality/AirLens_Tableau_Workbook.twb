    <worksheet name='Selected City Category Distribution'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontalignment='1' underline='true'>&lt;Sheet Name&gt;</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='airlens_historical_daily' name='federated.1j8udpt1l5kizn1aojj9h0inkld6' />
          </datasources>
          <datasource-dependencies datasource='federated.1j8udpt1l5kizn1aojj9h0inkld6'>
            <column caption='AQI Category Explanation' datatype='string' name='[Calculation_0867291714539546]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [aqi_category]&#13;&#10;&#13;&#10;WHEN &quot;Good&quot; THEN&#13;&#10;    &quot;AQI 0-50 | Minimal impact&quot;&#13;&#10;&#13;&#10;WHEN &quot;Satisfactory&quot; THEN&#13;&#10;    &quot;AQI 51-100 | Minor breathing discomfort for sensitive people&quot;&#13;&#10;&#13;&#10;WHEN &quot;Moderate&quot; THEN&#13;&#10;    &quot;AQI 101-200 | Breathing discomfort for people with lung or heart conditions&quot;&#13;&#10;&#13;&#10;WHEN &quot;Poor&quot; THEN&#13;&#10;    &quot;AQI 201-300 | Breathing discomfort on prolonged exposure&quot;&#13;&#10;&#13;&#10;WHEN &quot;Very Poor&quot; THEN&#13;&#10;    &quot;AQI 301-400 | Respiratory illness risk on prolonged exposure&quot;&#13;&#10;&#13;&#10;WHEN &quot;Severe&quot; THEN&#13;&#10;    &quot;AQI 401-500 | Serious health effects possible&quot;&#13;&#10;&#13;&#10;END' />
            </column>
            <column caption='Aqi' datatype='integer' name='[aqi]' role='measure' type='quantitative' />
            <column caption='Aqi Category' datatype='string' name='[aqi_category]' role='dimension' type='nominal' />
            <column-instance column='[Calculation_0867291714539546]' derivation='Attribute' name='[attr:Calculation_0867291714539546:nk]' pivot='key' type='nominal' />
            <column caption='City' datatype='string' name='[city]' role='dimension' semantic-role='[City].[Name]' type='nominal' />
            <column-instance column='[aqi_category]' derivation='None' name='[none:aqi_category:nk]' pivot='key' type='nominal' />
            <column-instance column='[city]' derivation='None' name='[none:city:nk]' pivot='key' type='nominal' />
            <column-instance column='[season]' derivation='None' name='[none:season:nk]' pivot='key' type='nominal' />
            <column-instance column='[state]' derivation='None' name='[none:state:nk]' pivot='key' type='nominal' />
            <column-instance column='[aqi]' derivation='Count' name='[pcto:cnt:aqi:qk]' pivot='key' type='quantitative'>
              <table-calc ordering-type='Rows' type='PctTotal' />
            </column-instance>
            <column caption='Season' datatype='string' name='[season]' role='dimension' type='nominal' />
            <column caption='State' datatype='string' name='[state]' role='dimension' semantic-role='[State].[Name]' type='nominal' />
          </datasource-dependencies>
          <filter class='categorical' column='[federated.1j8udpt1l5kizn1aojj9h0inkld6].[Action (City,State)]'>
            <groupfilter function='crossjoin' user:ui-action-filter='[Action6_4836471E53B3443D99C362C558612632]' user:ui-enumeration='all' user:ui-marker='enumerate'>
