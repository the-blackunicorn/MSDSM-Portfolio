    <worksheet name='Selected City Details'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontsize='10' underline='true'>&lt;Sheet Name&gt;</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='airlens_historical_daily' name='federated.1j8udpt1l5kizn1aojj9h0inkld6' />
          </datasources>
          <datasource-dependencies datasource='federated.1j8udpt1l5kizn1aojj9h0inkld6'>
            <column caption='Selected City Details' datatype='string' name='[Calculation_0867291717349403]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF NOT ISNULL(ATTR([city])) THEN&#13;&#10;&#13;&#10;&quot;SELECTED CITY&quot; + CHAR(10) + CHAR(10) +&#13;&#10;&#13;&#10;MIN([city]) + &quot;, &quot; + MIN([state]) + CHAR(10) + CHAR(10) +&#13;&#10;&#13;&#10;&quot;Average AQI: &quot; +&#13;&#10;STR(ROUND(AVG([aqi]),1)) + CHAR(10) +&#13;&#10;&#13;&#10;&quot;Median AQI: &quot; +&#13;&#10;STR(ROUND(MEDIAN([aqi]),0)) + CHAR(10) +&#13;&#10;&#13;&#10;&quot;Bad-Air %: &quot; +&#13;&#10;STR(ROUND(SUM([bad_air_day]) / COUNT([aqi]) * 100,2)) + &quot;%&quot; + CHAR(10) +&#13;&#10;&#13;&#10;&quot;Observations: &quot; +&#13;&#10;STR(COUNT([aqi])) + CHAR(10) + CHAR(10) +&#13;&#10;&#13;&#10;&quot;Coverage: &quot; +&#13;&#10;MIN([coverage_level]) + CHAR(10) +&#13;&#10;&#13;&#10;&quot;Coverage %: &quot; +&#13;&#10;STR(ROUND(MIN([coverage_pct]),2)) + &quot;%&quot; + CHAR(10) +&#13;&#10;&#13;&#10;&quot;Years Covered: &quot; +&#13;&#10;STR(MIN([years_covered])) + CHAR(10) +&#13;&#10;&#13;&#10;&quot;Longest Gap: &quot; +&#13;&#10;STR(MIN([longest_gap])) + &quot; Days&quot;&#13;&#10;&#13;&#10;ELSE&#13;&#10;&#13;&#10;&quot;SELECTED CITY&quot; + CHAR(10) + CHAR(10) +&#13;&#10;&#13;&#10;&quot;Select a city from the map to view its details&quot;&#13;&#10;&#13;&#10;END' />
            </column>
            <column caption='Aqi' datatype='integer' name='[aqi]' role='measure' type='quantitative' />
            <column caption='Bad Air Day' datatype='integer' name='[bad_air_day]' role='dimension' type='quantitative' />
            <column caption='City' datatype='string' name='[city]' role='dimension' semantic-role='[City].[Name]' type='nominal' />
            <column caption='Coverage Level' datatype='string' name='[coverage_level]' role='dimension' type='nominal' />
            <column caption='Coverage Pct' datatype='real' name='[coverage_pct]' role='measure' type='quantitative' />
            <column caption='Longest Gap' datatype='integer' name='[longest_gap]' role='measure' type='quantitative' />
            <column-instance column='[city]' derivation='None' name='[none:city:nk]' pivot='key' type='nominal' />
            <column-instance column='[season]' derivation='None' name='[none:season:nk]' pivot='key' type='nominal' />
            <column-instance column='[state]' derivation='None' name='[none:state:nk]' pivot='key' type='nominal' />
            <column caption='Season' datatype='string' name='[season]' role='dimension' type='nominal' />
            <column caption='State' datatype='string' name='[state]' role='dimension' semantic-role='[State].[Name]' type='nominal' />
            <column-instance column='[Calculation_0867291717349403]' derivation='User' name='[usr:Calculation_0867291717349403:nk]' pivot='key' type='nominal' />
            <column caption='Years Covered' datatype='integer' name='[years_covered]' role='measure' type='quantitative' />
          </datasource-dependencies>
          <filter class='categorical' column='[federated.1j8udpt1l5kizn1aojj9h0inkld6].[Action (City,State)]'>
            <groupfilter function='crossjoin' user:ui-action-filter='[Action6_4836471E53B3443D99C362C558612632]' user:ui-enumeration='all' user:ui-marker='enumerate'>
              <groupfilter function='level-members' level='[city]' />
              <groupfilter function='level-members' level='[state]' />
            </groupfilter>
          </filter>
          <filter class='categorical' column='[federated.1j8udpt1l5kizn1aojj9h0inkld6].[Action (State)]'>
            <groupfilter function='level-members' level='[state]' user:ui-action-filter='[Action5_3F7617C7AD0C4B2988267B81D4F108A7]' user:ui-enumeration='all' user:ui-marker='enumerate' />
          </filter>
          <slices>
            <column>[federated.1j8udpt1l5kizn1aojj9h0inkld6].[Action (City,State)]</column>
            <column>[federated.1j8udpt1l5kizn1aojj9h0inkld6].[Action (State)]</column>
            <column>[federated.1j8udpt1l5kizn1aojj9h0inkld6].[none:state:nk]</column>
            <column>[federated.1j8udpt1l5kizn1aojj9h0inkld6].[none:city:nk]</column>
            <column>[federated.1j8udpt1l5kizn1aojj9h0inkld6].[none:season:nk]</column>
          </slices>
          <aggregation value='true' />
        </view>
        <style />
        <panes>
          <pane selection-relaxation-option='selection-relaxation-allow'>
            <view>
              <breakdown value='auto' />
            </view>
            <mark class='Automatic' />
            <encodings>
              <text column='[federated.1j8udpt1l5kizn1aojj9h0inkld6].[usr:Calculation_0867291717349403:nk]' />
