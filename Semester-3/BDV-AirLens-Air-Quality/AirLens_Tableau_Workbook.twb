    <worksheet name='City AQI Trend'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontalignment='1' underline='true'>&lt;Sheet Name&gt;</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='airlens_historical_daily' name='federated.1j8udpt1l5kizn1aojj9h0inkld6' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Metric Selector' datatype='string' name='[Parameter 1325787663704072]' param-domain-type='list' role='measure' type='nominal' value='&quot;Average AQI&quot;'>
              <calculation class='tableau' formula='&quot;Average AQI&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.1j8udpt1l5kizn1aojj9h0inkld6'>
            <column caption='Selected Metric Display' datatype='string' name='[Calculation_0867291656134659]' role='measure' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 1325787663704072]&#13;&#10;&#13;&#10;WHEN &quot;Average AQI&quot; THEN&#13;&#10;    STR(ROUND(AVG([aqi]), 1))&#13;&#10;&#13;&#10;WHEN &quot;Median AQI&quot; THEN&#13;&#10;    STR(ROUND(MEDIAN([aqi]), 1))&#13;&#10;&#13;&#10;WHEN &quot;Bad-Air %&quot; THEN&#13;&#10;    STR(ROUND(&#13;&#10;        SUM([bad_air_day]) / COUNT([aqi]) * 100&#13;&#10;    , 2)) + &quot;%&quot;&#13;&#10;&#13;&#10;WHEN &quot;Observations&quot; THEN&#13;&#10;    STR(COUNT([aqi]))&#13;&#10;&#13;&#10;END' />
            </column>
            <column caption='Selected Metric' datatype='real' name='[Calculation_1325787664465929]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 1325787663704072]&#13;&#10;&#13;&#10;WHEN &quot;Average AQI&quot; THEN AVG([aqi])&#13;&#10;&#13;&#10;WHEN &quot;Median AQI&quot; THEN MEDIAN([aqi])&#13;&#10;&#13;&#10;WHEN &quot;Bad-Air %&quot; THEN&#13;&#10;    SUM([bad_air_day]) / COUNT([aqi])&#13;&#10;&#13;&#10;WHEN &quot;Observations&quot; THEN&#13;&#10;    COUNT([aqi])&#13;&#10;&#13;&#10;END' />
            </column>
            <column caption='Aqi' datatype='integer' name='[aqi]' role='measure' type='quantitative' />
            <column caption='Bad Air Day' datatype='integer' name='[bad_air_day]' role='dimension' type='quantitative' />
            <column caption='City' datatype='string' name='[city]' role='dimension' semantic-role='[City].[Name]' type='nominal' />
            <column caption='Month Start' datatype='date' default-format='*MMM YYYY' name='[month_start]' role='dimension' type='ordinal' />
            <column-instance column='[city]' derivation='None' name='[none:city:nk]' pivot='key' type='nominal' />
            <column-instance column='[month_start]' derivation='None' name='[none:month_start:qk]' pivot='key' type='quantitative' />
            <column-instance column='[season]' derivation='None' name='[none:season:nk]' pivot='key' type='nominal' />
            <column-instance column='[state]' derivation='None' name='[none:state:nk]' pivot='key' type='nominal' />
            <column caption='Season' datatype='string' name='[season]' role='dimension' type='nominal' />
            <column caption='State' datatype='string' name='[state]' role='dimension' semantic-role='[State].[Name]' type='nominal' />
            <column-instance column='[Calculation_0867291656134659]' derivation='User' name='[usr:Calculation_0867291656134659:nk]' pivot='key' type='nominal' />
            <column-instance column='[Calculation_1325787664465929]' derivation='User' name='[usr:Calculation_1325787664465929:qk]' pivot='key' type='quantitative' />
          </datasource-dependencies>
          <filter class='categorical' column='[federated.1j8udpt1l5kizn1aojj9h0inkld6].[Action (City,State)]'>
            <groupfilter function='crossjoin' user:ui-action-filter='[Action3_66F271CD89084822812EA175D2CD7D6E]' user:ui-enumeration='all' user:ui-marker='enumerate'>
              <groupfilter function='level-members' level='[city]' />
              <groupfilter function='level-members' level='[state]' />
            </groupfilter>
          </filter>
          <filter class='quantitative' column='[federated.1j8udpt1l5kizn1aojj9h0inkld6].[usr:Calculation_1325787664465929:qk]' included-values='all' />
          <slices>
            <column>[federated.1j8udpt1l5kizn1aojj9h0inkld6].[usr:Calculation_1325787664465929:qk]</column>
            <column>[federated.1j8udpt1l5kizn1aojj9h0inkld6].[Action (City,State)]</column>
            <column>[federated.1j8udpt1l5kizn1aojj9h0inkld6].[none:state:nk]</column>
