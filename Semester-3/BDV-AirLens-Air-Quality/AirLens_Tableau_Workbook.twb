    <worksheet name='Monthly AQI Category Composition'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontalignment='1' underline='true'>&lt;Sheet Name&gt;</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='airlens_historical_daily' name='federated.1j8udpt1l5kizn1aojj9h0inkld6' />
          </datasources>
          <datasource-dependencies datasource='federated.1j8udpt1l5kizn1aojj9h0inkld6'>
            <column caption='Season Months' datatype='string' name='[Calculation_0867291720241180]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [season]&#13;&#10;&#13;&#10;WHEN &quot;Winter&quot; THEN&#13;&#10;&quot;December, January, February&quot;&#13;&#10;&#13;&#10;WHEN &quot;Summer&quot; THEN&#13;&#10;&quot;March, April, May&quot;&#13;&#10;&#13;&#10;WHEN &quot;Monsoon&quot; THEN&#13;&#10;&quot;June, July, August, September&quot;&#13;&#10;&#13;&#10;WHEN &quot;Post-monsoon&quot; THEN&#13;&#10;&quot;October, November&quot;&#13;&#10;&#13;&#10;END' />
            </column>
            <column caption='Aqi' datatype='integer' name='[aqi]' role='measure' type='quantitative' />
            <column caption='Aqi Category' datatype='string' name='[aqi_category]' role='dimension' type='nominal' />
            <column caption='City' datatype='string' name='[city]' role='dimension' semantic-role='[City].[Name]' type='nominal' />
            <column caption='Date Year' datatype='integer' name='[date_year]' role='dimension' type='quantitative' />
            <column caption='Month Name' datatype='string' name='[month_name]' role='dimension' type='nominal' />
            <column-instance column='[aqi_category]' derivation='None' name='[none:aqi_category:nk]' pivot='key' type='nominal' />
            <column-instance column='[city]' derivation='None' name='[none:city:nk]' pivot='key' type='nominal' />
            <column-instance column='[date_year]' derivation='None' name='[none:date_year:ok]' pivot='key' type='ordinal' />
            <column-instance column='[date_year]' derivation='None' name='[none:date_year:qk]' pivot='key' type='quantitative' />
            <column-instance column='[month_name]' derivation='None' name='[none:month_name:nk]' pivot='key' type='nominal' />
            <column-instance column='[season]' derivation='None' name='[none:season:nk]' pivot='key' type='nominal' />
            <column-instance column='[state]' derivation='None' name='[none:state:nk]' pivot='key' type='nominal' />
            <column-instance column='[aqi]' derivation='Count' name='[pcto:cnt:aqi:qk:3]' pivot='key' type='quantitative'>
              <table-calc ordering-type='Columns' type='PctTotal' />
